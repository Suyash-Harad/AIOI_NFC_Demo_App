<?xml version="1.0" encoding="utf-8"?>
<!-- Save as: res/drawable/url_background.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color with slight transparency -->
    <solid android:color="@color/gray_100" />

    <!-- Rounded corners -->
    <corners android:radius="8dp" />

    <!-- Subtle border -->
    <stroke
        android:width="1dp"
        android:color="@color/border_primary" />

    <!-- Optional padding can be added here if needed -->
    <padding
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp" />

</shape>