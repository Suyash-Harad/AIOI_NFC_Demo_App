<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_primary"
        android:elevation="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingVertical="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.App.Header.IconButton"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/txtTitle"
            style="@style/Widget.App.Header.Title"
            android:text="Template Designer" />

        <!-- keeps the title centred -->
        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>

    <!-- Name + display size -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp">

        <EditText
            android:id="@+id/etName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Template name"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLength="24"
            android:maxLines="1" />

        <Spinner
            android:id="@+id/spSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- Add components -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddText"
                style="@style/Widget.App.Button.Tool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddRect"
                style="@style/Widget.App.Button.Tool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Rectangle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddEllipse"
                style="@style/Widget.App.Button.Tool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Ellipse" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddLine"
                style="@style/Widget.App.Button.Tool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Line" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddImage"
                style="@style/Widget.App.Button.Tool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Image" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddBarcode"
                style="@style/Widget.App.Button.Tool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Barcode" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Canvas -->
    <com.bartech.demonfc_app.template.TemplateCanvasView
        android:id="@+id/canvasView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Actions on the selected component -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProps"
                style="@style/Widget.App.Button.Tool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Properties" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDuplicate"
                style="@style/Widget.App.Button.Tool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Duplicate" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnForward"
                style="@style/Widget.App.Button.Tool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bring forward" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackward"
                style="@style/Widget.App.Button.Tool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send back" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.App.Button.Tool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMono"
                style="@style/Widget.App.Button.Tool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tag view" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Save -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save template" />

    </LinearLayout>

</LinearLayout>