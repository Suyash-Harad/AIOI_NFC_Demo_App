<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ====================================================== -->
    <!-- Primary Button (Default)                               -->
    <!-- ====================================================== -->

    <style name="Widget.App.Button.Primary"
        parent="Widget.Material3.Button">

        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>

        <item name="android:textColor">@color/color_on_primary</item>
        <item name="backgroundTint">@color/button_primary</item>

        <item name="cornerRadius">12dp</item>

        <item name="android:minHeight">52dp</item>

        <item name="elevation">3dp</item>

    </style>

    <!-- ====================================================== -->
    <!-- Secondary Button                                       -->
    <!-- ====================================================== -->

    <style name="Widget.App.Button.Secondary"
        parent="Widget.Material3.Button">

        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>

        <item name="android:textColor">@color/color_on_primary</item>
        <item name="backgroundTint">@color/button_secondary</item>

        <item name="cornerRadius">12dp</item>

        <item name="android:minHeight">52dp</item>

        <item name="android:enabled">true</item>

    </style>

    <!-- ====================================================== -->
    <!-- Outlined Button                                        -->
    <!-- ====================================================== -->

    <style name="Widget.App.Button.Outlined"
        parent="Widget.Material3.Button.OutlinedButton">

        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>

        <item name="android:textColor">@color/button_primary</item>

        <item name="strokeColor">@color/button_primary</item>

        <item name="strokeWidth">1dp</item>

        <item name="cornerRadius">12dp</item>

        <item name="android:enabled">true</item>

    </style>

    <!-- ====================================================== -->
    <!-- Text Button                                            -->
    <!-- ====================================================== -->

    <style name="Widget.App.Button.Text"
        parent="Widget.Material3.Button.TextButton">

        <item name="android:textAllCaps">false</item>

        <item name="android:textStyle">bold</item>

        <item name="android:textColor">@color/button_primary</item>

        <item name="android:enabled">true</item>

    </style>

    <!-- ====================================================== -->
    <!-- Success Button                                         -->
    <!-- ====================================================== -->

    <style name="Widget.App.Button.Success"
        parent="Widget.Material3.Button">

        <item name="android:textAllCaps">false</item>

        <item name="android:textStyle">bold</item>

        <item name="android:textColor">@color/white</item>

        <item name="backgroundTint">@color/success</item>

        <item name="cornerRadius">12dp</item>

        <item name="android:enabled">true</item>

    </style>

    <!-- ====================================================== -->
    <!-- Warning Button                                         -->
    <!-- ====================================================== -->

    <style name="Widget.App.Button.Warning"
        parent="Widget.Material3.Button">

        <item name="android:textAllCaps">false</item>

        <item name="android:textStyle">bold</item>

        <item name="android:textColor">@color/black</item>

        <item name="backgroundTint">@color/warning</item>

        <item name="cornerRadius">12dp</item>

        <item name="android:enabled">true</item>

    </style>

    <!-- ====================================================== -->
    <!-- Error Button                                           -->
    <!-- ====================================================== -->

    <style name="Widget.App.Button.Error"
        parent="Widget.Material3.Button">

        <item name="android:textAllCaps">false</item>

        <item name="android:textStyle">bold</item>

        <item name="android:textColor">@color/white</item>

        <item name="backgroundTint">@color/error</item>

        <item name="cornerRadius">12dp</item>

        <item name="android:enabled">true</item>

    </style>

    <!-- ====================================================== -->
    <!-- Disabled Button                                        -->
    <!-- ====================================================== -->

    <style name="Widget.App.Button.Disabled"
        parent="Widget.Material3.Button">

        <item name="android:textAllCaps">false</item>

        <item name="android:textStyle">bold</item>

        <item name="android:textColor">@color/text_tertiary</item>

        <item name="backgroundTint">@color/button_disabled</item>

        <item name="cornerRadius">12dp</item>

        <item name="android:minHeight">52dp</item>

        <item name="android:enabled">false</item>

    </style>

</resources>